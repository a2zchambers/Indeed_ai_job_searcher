                CREATE TABLE IF NOT EXISTS job_agent_pipeline (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    search_query TEXT,
                    job_url TEXT UNIQUE,
                    job_title TEXT,
                    company TEXT,
