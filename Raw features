            }
            for col, dtype in migration_cols.items():
                if col not in columns:
                    cursor.execute(f"ALTER TABLE job_agent_pipeline ADD COLUMN {col} {dtype}")
            conn.commit()
            return True
    except Exception as e:
        st.error(f"Database Initialization Error: {str(e)}")
        return False

