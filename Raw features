                    hm_phone TEXT DEFAULT '',
                    hm_linkedin TEXT DEFAULT '',
                    hm_interests TEXT DEFAULT '',
                    company_mission TEXT DEFAULT '',
                    strategic_positioning TEXT DEFAULT ''
                )
            ''')
            # Safe schema migrations for existing databases
            cursor.execute("PRAGMA table_info(job_agent_pipeline)")
            columns = [info[1] for info in cursor.fetchall()]
            migration_cols = {
                "street_address": "TEXT",
                "notes": "TEXT DEFAULT ''",
                "hm_name": "TEXT DEFAULT ''",
                "hm_email": "TEXT DEFAULT ''",
                "hm_phone": "TEXT DEFAULT ''",
